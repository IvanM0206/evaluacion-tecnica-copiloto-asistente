# Copiar a .env (no se commitea). Sin ANTHROPIC_API_KEY el sistema corre en modo mock.
LLM_PROVIDER=mock
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
# API_BASE_URL=http://127.0.0.1:8000/api
# Habilita POST /api/catalog/incidents (header X-Catalog-Token). Sin definir: deshabilitado.
# CATALOG_API_TOKEN=
